# Adjust the path, owner, and group to match the web server installation.
/var/log/nginx/access.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0640 root adm
    sharedscripts
    prerotate
        systemctl start --wait stats-update.service
    endscript
    postrotate
        # This template targets nginx; reopen the new file before stats reads it.
        if [ -r /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)"
        fi
        systemctl start --wait stats-update.service
    endscript
}
