# Adjust the path, owner, and group to match the web server installation.
/var/log/nginx/access.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    # stats-update.service runs as stats and must read the new file after
    # rotation. Keep the reader group explicit instead of relying on adm.
    create 0640 root @STATS_GROUP@
    sharedscripts
    prerotate
        systemctl start --wait stats-update.service
    endscript
    postrotate
        # This template targets nginx; reopen the new file before stats reads it.
        if [ -r /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)"
        fi
        systemctl start --wait stats-update.service
    endscript
}
