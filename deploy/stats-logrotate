# Adjust the path, owner, and group to match the web server installation.
/var/log/nginx/access.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0640 root adm
    sharedscripts
    prerotate
        systemctl start --wait stats-update.service
    endscript
    postrotate
        # The web server must reopen its log file before the update below, or it keeps
        # writing to the renamed file. Send that deployment's reopen signal here, e.g.
        # for nginx: kill -USR1 "$(cat /run/nginx.pid)"
        systemctl start --wait stats-update.service
    endscript
}
