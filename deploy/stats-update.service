[Unit]
Description=Update Stats web log analytics
After=local-fs.target

[Service]
Type=oneshot
User=stats
Group=stats
ExecStart=@STATS_BINARY_PATH@ update --config=@STATS_CONFIG_PATH@
TimeoutStartSec=5min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@STATS_DATA_DIR@ @STATS_OUTPUT_DIR@

[Install]
WantedBy=multi-user.target
