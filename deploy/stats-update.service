[Unit]
Description=Update Stats web log analytics
After=local-fs.target

[Service]
Type=oneshot
User=stats
Group=stats
ExecStart=/opt/stats/bin/stats update --config=/opt/stats/etc/awstats.example.test.conf
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/stats/var/lib /opt/stats/var/www

[Install]
WantedBy=multi-user.target
